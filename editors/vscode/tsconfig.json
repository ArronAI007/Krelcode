{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@krelcode/editor-bridge": ["../shared/src/index.ts"],
      "@krelcode/sdk": ["../../typescript-sdk/src/index.ts"]
    },
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
